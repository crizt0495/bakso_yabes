# Salin file ini menjadi .env.local lalu isi nilainya.
# Lihat docs/SUPABASE.md untuk panduan mendapatkan nilai-nilai berikut.

# Koneksi Supabase (aman untuk browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KHUSUS SERVER - JANGAN pernah dimasukkan ke kode client / Vercel "exposed"
SUPABASE_SERVICE_ROLE_KEY=

# Secret sekali-pakai untuk endpoint /api/setup (pembuatan akun pemilik pertama)
# Isi dengan string acak yang kuat, hapus variabel ini dari environment
# setelah pemilik dibuat.
SETUP_SECRET=
